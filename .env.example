# Copie este arquivo para ".env" e ajuste os valores conforme o ambiente.
# NUNCA faça commit do arquivo ".env" real (ele já está no .gitignore).

# Nome e versao exibidos no Swagger.
APP_NAME=API de Gerenciamento de Tarefas
APP_VERSION=1.0.0

# Caminho do banco SQLite.
# Desenvolvimento local (padrao, relativo ao projeto):
DATABASE_URL=sqlite:///./data/tarefas.db
# Producao na VM Azure (diretorio persistente, fora do /tmp da VM):
# DATABASE_URL=sqlite:////var/lib/api-tarefas/tarefas.db

# Insere tarefas de exemplo se o banco estiver vazio (apenas para demos).
SEED_DEMO_DATA=false

# Limites de paginacao e validacao.
MAX_PAGE_SIZE=100
TITULO_MAX_LENGTH=200
DESCRICAO_MAX_LENGTH=2000
